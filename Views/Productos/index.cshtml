@model IEnumerable<Productos>

<section class="container mt-4">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Lista de Productos</h2>
        <a asp-controller="Productos" asp-action="Create" class="btn btn-primary">Crear Nuevo Producto</a>
    </header>

    <table class="table table-striped table-hover text-center align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th style="width: 10%;">Id</th>
                <th style="width: 50%;">Descripción</th>
                <th style="width: 20%;">Precio</th>
                <th style="width: 20%;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model)
            {
                <tr>
                    <td>@producto.idProducto</td>
                    <td class="text-start">@producto.Descripcion</td> <!-- Alineado a la izquierda -->
                    <td class="text-success fw-bold">$@producto.Precio.ToString("N2")</td> <!-- Formato de precio -->
                    <td>
                        <a asp-controller="Productos" asp-action="Edit" asp-route-id="@producto.idProducto" 
                           class="btn btn-warning btn-sm">Modificar</a>
                        <a asp-controller="Productos" asp-action="Delete" asp-route-id="@producto.idProducto" 
                           class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>