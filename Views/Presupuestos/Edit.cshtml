@model Presupuestos

<h2>Editar Presupuesto</h2>

<form asp-action="Edit" method="post" class="mt-3">

    <input type="hidden" asp-for="idPresupuesto" />

    <div class="mb-3">
        <label asp-for="NombreDestinatario" class="form-label"></label>
        <input asp-for="NombreDestinatario" class="form-control" />
        <span asp-validation-for="NombreDestinatario" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaCreacion" class="form-label"></label>
        <input asp-for="FechaCreacion" class="form-control" type="date" />
        <span asp-validation-for="FechaCreacion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>

</form>


<partial name="_ValidationScriptsPartial" />


