@model IEnumerable<Presupuestos>

<section class="container mt-4">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Lista de Presupuestos</h2>
        <a asp-controller="Presupuestos" asp-action="Create" class="btn btn-primary">Crear Nuevo Presupuesto</a>
    </header>

    <table class="table table-striped table-hover text-center align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th style="width: 10%;">Id</th>
                <th style="width: 30%;">Nombre/Destinatario</th>
                <th style="width: 20%;">Fecha Creación</th>
                <th style="width: 40%;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var presupuesto in Model)
            {
                <tr>
                    <td>@presupuesto.idPresupuesto</td>
                    <td class="text-start">@presupuesto.NombreDestinatario</td>
                    <td>@presupuesto.FechaCreacion.ToString("dd/MM/yyyy")</td> <!-- CORREGIDO: fuera del td extra -->
                    <td>
                        <div class="d-flex gap-1 justify-content-center">
                            <a asp-controller="Presupuestos" asp-action="Details" asp-route-idPresupuesto="@presupuesto.idPresupuesto" class="btn btn-info btn-sm">Detalle</a>
                            <a asp-controller="Presupuestos" asp-action="Edit" asp-route-idPresupuesto="@presupuesto.idPresupuesto" class="btn btn-warning btn-sm">Modificar</a>
                            <a asp-controller="Presupuestos" asp-action="AgregarProducto" asp-route-idPresupuesto="@presupuesto.idPresupuesto" class="btn btn-success btn-sm">Agregar Producto</a>
                            <a asp-controller="Presupuestos" asp-action="Delete" asp-route-idPresupuesto="@presupuesto.idPresupuesto" class="btn btn-danger btn-sm">Eliminar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>