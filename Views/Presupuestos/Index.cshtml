@model IEnumerable<Presupuestos>

<section class="container mt-4">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Lista de Presupuestos</h2>
        <a asp-controller="Presupuestos" asp-action="Create" class="btn btn-primary">Crear Nuevo Presupuesto</a>
    </header>

    <table class="table table-striped table-hover text-center align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th style="width: 10%;">Id</th>
                <th style="width: 20%;">NombreDestinatario</th>
                <th style="width: 50%;">FechaCreacion</th>
                <th style="width: 20%;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var presupuestos in Model)
            {
                <tr>
                    <td>@presupuestos.idPresupuesto</td>
                    <td class="text-break">@presupuestos.NombreDestinatario</td>
                    <td class="text-break">@presupuestos.FechaCreacion</td>

                    <td class="d-flex gap-2 justify-content-center">
                        <a asp-controller="Presupuestos" asp-action="Details" asp-route-idPresupuesto="@presupuestos.idPresupuesto" class="btn btn-info">Detalle</a>
                        <a asp-controller="Presupuestos" asp-action="Edit" asp-route-idPresupuesto="@presupuestos.idPresupuesto" class="btn btn-warning">Modificar</a>
                        <a asp-controller="Presupuestos" asp-action="AgregarProducto" asp-route-idPresupuesto="@presupuestos.idPresupuesto" class="btn btn-dark">Agregar Producto</a>
                        <a asp-controller ="Presupuestos" asp-action="Delete" asp-route-idPresupuesto="@presupuestos.idPresupuesto" class="btn btn-danger">Eliminar</a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</section>
